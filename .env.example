EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In (Firebase Console → Authentication → Google → Web client ID)
# Android client must match the upload-key SHA-1 registered in Firebase
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Web client ID must be client_type 3 from the same Firebase project as google-services.json
EXPO_PUBLIC_FACEBOOK_APP_ID=
EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=

# Re-import course structure from bridge-academy.vn (optional — run npm run import:course)
# Pre-translate UI + course JSON: npm run translate (requires GOOGLE_TRANSLATE_API_KEY)
GOOGLE_TRANSLATE_API_KEY=

# bridge-academy.vn account (enrolled in course) — for npm run import:content
WP_LOGIN=sumaiyanemo@gmail.com
WP_PASSWORD=Bridge_admin2026

# Bootstrap admin (npm run setup:firebase)
ADMIN_EMAIL=admin@bridgeacademy.com
ADMIN_PASSWORD=
