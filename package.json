{
  "name": "academy",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-navigation/bottom-tabs": "^7.16.1",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.1",
    "expo": "~54.0.35",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.11",
    "expo-av": "~16.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "firebase": "^12.14.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-webview": "13.15.0"
  },
  "scripts": {
    "start": "node init && expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "+": "expo start --web",
    "admin": "npm --prefix admin run dev",
    "admin:build": "npm --prefix admin run build",
    "import:course": "node scripts/import-bridge-course.mjs --write",
    "import:content": "node scripts/import-bridge-content.mjs --write",
    "backfill:audio": "node scripts/backfill-audio.mjs --write --fetch",
    "backfill:audio:media": "node scripts/backfill-audio-from-media.mjs --write",
    "translate": "node scripts/translate-app.mjs",
    "translate:ui": "node scripts/translate-app.mjs --ui-only",
    "translate:course": "node scripts/translate-app.mjs --course-only",
    "sync:translations": "node scripts/sync-translation-files.mjs",
    "setup:firebase": "node scripts/firebase-bootstrap.mjs",
    "validate:course": "node scripts/validate-course.mjs",
    "build:apk": "node init && eas build --platform android --profile preview --non-interactive",
    "build:apk:debug": "node init && eas build --platform android --profile debug --non-interactive",
    "build:apk:local": "node init && eas build --platform android --profile preview --local",
    "build:apk:windows": "node init && powershell -ExecutionPolicy Bypass -File scripts/build-apk-windows.ps1"
  },
  "private": true,
  "devDependencies": {
    "eas-cli": "^16.17.4",
    "firebase-tools": "^15.25.1"
  }
}
